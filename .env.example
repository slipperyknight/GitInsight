# Copy to .env and fill in. The backend loads this via python-dotenv.

# Postgres (matches docker-compose.yml)
# DATABASE_URL is the trusted/superuser connection — used by migrate, seed.py, enrich.py.
# It BYPASSES Row-Level Security (postgres superuser), which is what batch writers want.
DATABASE_URL=postgresql://gitinsight:gitinsight@localhost:5432/gitinsight

# APP_DATABASE_URL is the non-superuser app_user connection — used by the FastAPI app.
# RLS is ENFORCED on this connection; the org-GUC session helper sets app.org_id per request.
APP_DATABASE_URL=postgresql://app_user:app_pw@localhost:5432/gitinsight

# Anthropic — required for Phase 3 enrichment (Haiku + Sonnet) and Phase 4 summaries.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
